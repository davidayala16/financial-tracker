# Copy to .env.local for local dev. In production (Vercel) and in CI (GitHub
# Actions), set these as environment variables / secrets instead — never
# commit real values.

# --- Auth (gates the whole dashboard to just you) ---
# Google OAuth app credentials (console.cloud.google.com > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Random string, e.g. `openssl rand -base64 32`
AUTH_SECRET=
# Only this email may sign in
ALLOWED_EMAIL=you@example.com

# --- Plaid ---
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox while testing, production once you're connecting real accounts
PLAID_ENV=sandbox

# --- Supabase (source of truth) ---
# Project Settings > API
SUPABASE_URL=
# service_role key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Sheets (free mirror/backup, written by the sync job) ---
# Reuses AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET above as the OAuth client.
# GOOGLE_REFRESH_TOKEN is obtained once via OAuth Playground -- see README.
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
